{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                i.id,\n                i.category_id,\n                c.name AS \"category_name?\",\n                i.sku,\n                i.name,\n                i.reference_price,\n                i.status::text AS \"status!\",\n                i.created_at,\n                i.updated_at,\n                i.version\n            FROM coupon.catalog_items i\n            LEFT JOIN coupon.catalog_categories c ON c.id = i.category_id\n            WHERE i.store_id = $1\n              AND (i.status = 'ACTIVE' OR $2)\n              AND i.status <> 'ARCHIVED'\n            ORDER BY i.name\n            ",
