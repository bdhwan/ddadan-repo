{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                t.id,\n                t.store_id,\n                s.name AS store_name,\n                u.consumer_key,\n                u.display_name,\n                t.policy_id,\n                t.business_day,\n                t.quantity,\n                t.status::text AS \"status!\",\n                t.external_order_ref,\n                t.order_snapshot,\n                t.approved_by_user_id,\n                t.confirmed_at,\n                t.voided_at,\n                t.void_reason,\n                t.version\n            FROM coupon.stamp_transactions t\n            JOIN coupon.stores s ON s.id = t.store_id\n            JOIN coupon.users u ON u.id = t.user_id\n            WHERE t.id = $1\n            ",
