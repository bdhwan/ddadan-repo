  "query": "\n            SELECT\n                id,\n                status::text AS \"status!\",\n                name,\n                timezone,\n                to_char(business_day_cutoff, 'HH24:MI:SS') AS \"business_day_cutoff!\"\n            FROM coupon.stores\n            WHERE owner_user_id = $1 AND status <> 'CLOSED'\n            ",
