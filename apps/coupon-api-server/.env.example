# Example configuration for the coupon API server.
#
# Copy to `.env` and adjust. NO REAL SECRETS BELONG IN THIS FILE OR IN THE REPOSITORY
# (§16.5) — production values come from the secret manager.
#
#   set -a && . ./.env && set +a && cargo run --bin coupon-api

# development | test | staging | production
COUPON_ENV=development
COUPON_BIND_ADDR=0.0.0.0:7810

# Matches docker-compose.dev.yml. Local-only credentials.
COUPON_DATABASE_URL=postgres://coupon:coupon_dev_password@localhost:55432/coupon
COUPON_DATABASE_MAX_CONNECTIONS=16
COUPON_REDIS_URL=redis://localhost:56379

# Firebase project id: the ID token `aud`, and the suffix of the expected `iss`.
COUPON_FIREBASE_PROJECT_ID=ddadan-dev
# Optional extra audiences, e.g. a separate admin tenant (§9.3).
# COUPON_FIREBASE_EXTRA_AUDIENCES=ddadan-admin

# Exact browser origins allowed to make state-changing calls (§16.3).
# Required in production.
COUPON_ALLOWED_ORIGINS=http://localhost:4310,http://localhost:4320,http://localhost:4330

# Accept `X-Dev-Firebase-Uid: <uid>` instead of a real ID token.
# The process REFUSES TO BOOT if this is set while COUPON_ENV=production.
COUPON_AUTH_DEV_BYPASS=1

# How fresh a sign-in must be for high-risk endpoints (§9.3).
COUPON_RECENT_AUTH_MAX_AGE_SECS=600
# How long a completed idempotency record stays replayable.
COUPON_IDEMPOTENCY_TTL_HOURS=24

# Column encryption and keyed lookup hashes (§16.5). Required in production; outside it,
# a deterministic development key is used so local runs work without key handling.
# Generate with: openssl rand -base64 32
# COUPON_DATA_ENCRYPTION_KEY=
# COUPON_LOOKUP_HASH_SECRET=

# Base64 32-byte Ed25519 seed for the rotating QR signature (§16.2). Asymmetric on
# purpose: a verifier must not be able to mint tokens. Required in production; outside it
# a deterministic development seed is derived so local runs need no key handling.
# Generate with: openssl rand -base64 32
# COUPON_QR_SIGNING_KEY=

# QR lifetime in seconds (§16.2 fixes this at 60; 10–300 accepted for a slow venue).
COUPON_QR_TOKEN_TTL_SECS=60
# How long a store owner may reverse their own accrual (§8.6).
COUPON_STAMP_VOID_WINDOW_HOURS=24
# How long an administrative adjustment preview stays executable (§13.4).
COUPON_ADMIN_PREVIEW_TTL_MINUTES=15

# §16.4 rate limits, per minute. Operational settings rather than constants, so a busy
# Saturday can be accommodated without a deploy. Redis makes them cluster-wide; without it
# they degrade to per-process rather than failing the request.
COUPON_RATE_LIMIT_QR_ISSUE_PER_MIN=20
COUPON_RATE_LIMIT_QR_RESOLVE_FAILURE_PER_MIN=30
COUPON_RATE_LIMIT_STAMP_APPROVAL_PER_MIN=30

# json | pretty
COUPON_LOG_FORMAT=pretty
COUPON_LOG_FILTER=info,sqlx=warn,tower_http=info
