{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT id, aggregate_type, aggregate_id, event_type, correlation_id, payload,\n                   created_at\n            FROM coupon.outbox_events\n            WHERE status IN ('PENDING', 'FAILED')\n              AND event_type NOT IN ('JOB_ENQUEUED', 'JOB_RESUMED')\n              AND available_at <= $1\n            ORDER BY created_at\n            LIMIT $2\n            FOR UPDATE SKIP LOCKED\n            ",
