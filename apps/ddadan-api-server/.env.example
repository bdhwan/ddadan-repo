# API server (bind on all interfaces for LAN access by default)
HOST=0.0.0.0
PORT=7800
NODE_ENV=development

# SQLite (default: <assets dir>/ddadan.sqlite e.g. ~/Desktop/resource/ddadan.sqlite)
# DB_PATH=./data/ddadan.sqlite
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Local asset storage (default: ~/Desktop/resource if ASSETS_DIR unset)
# ASSETS_DIR=./storage/custom-assets
ASSETS_PUBLIC_PATH=/static/assets

# Heartbeat (device TTL). Health: GET /api/health/live, /api/health/ready
HEARTBEAT_OFFLINE_AFTER_SECONDS=60
