# API server
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:4200,http://localhost:4300

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=ddadan
DB_PASSWORD=ddadan
DB_DATABASE=ddadan
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Redis (used by BullMQ + heartbeat TTL)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Firebase Admin
# Path is relative to the api server package root.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase/service-account.json

# Local asset storage
ASSETS_DIR=./storage/assets
ASSETS_PUBLIC_PATH=/static/assets

# Heartbeat
HEARTBEAT_OFFLINE_AFTER_SECONDS=60
