# DDADAN Pi service configuration

# API server base URL (no trailing slash)
DDADAN_API_BASE=http://localhost:3000/api

# Admin web URL (used for unregistered devices' "register" screen)
DDADAN_ADMIN_BASE=http://localhost:4200

# Player web URL (the fullscreen client app)
DDADAN_PLAYER_BASE=http://localhost:4300

# Heartbeat interval in seconds
DDADAN_HEARTBEAT_INTERVAL_S=20

# Override hardware id (otherwise read from /etc/machine-id or eth0 mac).
# Useful for local development.
DDADAN_HARDWARE_ID=

# Chromium binary; default tries chromium-browser then chromium
DDADAN_BROWSER_BIN=

# 1 to actually launch chromium kiosk, 0 to dry-run (logs only)
DDADAN_LAUNCH_KIOSK=0

# App version reported via heartbeat
DDADAN_APP_VERSION=0.1.0
