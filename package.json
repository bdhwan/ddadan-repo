{
  "name": "ddadan-repo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "dev:api": "npm run start:dev --workspace ddadan-api-server",
    "dev:admin": "npm run start --workspace ddadan-admin-app",
    "dev:client": "npm run start --workspace ddadan-client-app",
    "dev:pi": "npm run dev --workspace ddadan-service-pi",
    "build:api": "npm run build --workspace ddadan-api-server",
    "build:admin": "npm run build --workspace ddadan-admin-app",
    "build:client": "npm run build --workspace ddadan-client-app",
    "build:pi": "npm run build --workspace ddadan-service-pi",
    "build:android": "cd apps/ddadan-android-app && ./gradlew assembleDebug",
    "run:android": "cd apps/ddadan-android-app && ./gradlew assembleDebug && android run --apks=app/build/outputs/apk/debug/app-debug.apk --activity=com.ddadan.player.MainActivity --debug",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  }
}
